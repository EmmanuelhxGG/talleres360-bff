# Copiar como .env (ignorado por git) y completar.

# Entra ID: registro de la API (api-cloud)
ENTRA_TENANT_ID=
API_CLIENT_ID=

# Cada microservicio vive en una EC2 independiente de la misma VPC.
# Usar su IP privada; no la publica ni localhost.
ORDERS_URL=http://IP_PRIVADA_EC2_ORDENES:8081
CATALOG_URL=http://IP_PRIVADA_EC2_CATALOGO:8082
REPORT_URL=http://IP_PRIVADA_EC2_REPORTES:8083
NOTIFICATIONS_URL=http://IP_PRIVADA_EC2_NOTIFICACIONES:8084
AUDIT_URL=http://IP_PRIVADA_EC2_AUDITORIA:8085
# Misma clave en BFF, Ordenes, Catalogo y Reporteria; nunca publicarla.
INTERNAL_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Subir a DEBUG para diagnosticar 401/403 en el BFF
SECURITY_LOG_LEVEL=INFO
